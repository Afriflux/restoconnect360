# 🚀 AFRIFLUX - RESTAURANT SAAS PLATFORM
# Configuration d'environnement

# Application
APP_NAME="Afriflux"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afriflux_development
DB_USERNAME=root
DB_PASSWORD=

# Cache et Sessions
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paiements Africains - CinetPay
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_ENVIRONMENT=sandbox
CINETPAY_CURRENCY=XOF
CINETPAY_RETURN_URL=${APP_URL}/payment/success
CINETPAY_CANCEL_URL=${APP_URL}/payment/cancel
CINETPAY_NOTIFY_URL=${APP_URL}/payment/notify

# Paiements Africains - PayTech
PAYTECH_API_KEY=your_paytech_api_key
PAYTECH_MERCHANT_ID=your_paytech_merchant_id
PAYTECH_ENVIRONMENT=sandbox
PAYTECH_CURRENCY=XOF
PAYTECH_RETURN_URL=${APP_URL}/payment/success
PAYTECH_CANCEL_URL=${APP_URL}/payment/cancel
PAYTECH_NOTIFY_URL=${APP_URL}/payment/notify

# Paiements Internationaux - Stripe
STRIPE_KEY=your_stripe_public_key
STRIPE_SECRET=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Paiements Internationaux - PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# WhatsApp Business API
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# SMS - Twilio
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email - SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@restoconnect360.com
SENDGRID_FROM_NAME="Afriflux"

# Géolocalisation - Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics - Google Analytics
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# Notifications Push
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# File Storage
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcasting
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Queue
QUEUE_CONNECTION=redis

# Horizon
HORIZON_PREFIX=horizon

# Telescope
TELESCOPE_ENABLED=true

# Debug
DEBUGBAR_ENABLED=true

# Security
BCRYPT_ROUNDS=12
HASH_VERIFY=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOWED_METHODS=*

# API
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=1

# Webhooks
WEBHOOK_SECRET=your_webhook_secret

# Development
DEV_MODE=true
DEV_DEBUG=true
DEV_LOG_LEVEL=debug

# Production
PROD_MODE=false
PROD_DEBUG=false
PROD_LOG_LEVEL=error

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Monitoring
MONITORING_ENABLED=true
MONITORING_EMAIL=admin@restoconnect360.com

# Support
SUPPORT_EMAIL=support@restoconnect360.com
SUPPORT_PHONE=+221781000064

# Company
COMPANY_NAME="Afriflux"
COMPANY_EMAIL="contact@restoconnect360.com"
COMPANY_PHONE="+221781000064"
COMPANY_ADDRESS="Liberté 6 JVC, Dakar, Sénégal"
COMPANY_WEBSITE="https://www.restoconnect360.com"