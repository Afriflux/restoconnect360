{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "restoconnect360",
    "description": "Plateforme SaaS Multi-Restaurant pour l'Afrique de l'Ouest",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0 --port 5173",
        "preview": "vite preview",
        "setup": "npm install && npm run build",
        "windsurf": "concurrently \"php artisan serve --host=0.0.0.0 --port=8000\" \"npm run dev\"",
        "windsurf:full": "concurrently \"php artisan serve --host=0.0.0.0 --port=8000\" \"npm run dev\" \"php artisan horizon\"",
        "test": "php artisan test",
        "optimize": "php artisan optimize",
        "cache:clear": "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear",
        "fresh": "php artisan migrate:fresh --seed",
        "monitor": "php artisan horizon:status",
        "logs": "tail -f storage/logs/laravel.log"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^0.8.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.18",
        "vite": "^4.5.3"
    },
    "dependencies": {
        "@googlemaps/js-api-loader": "^2.0.1",
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@sentry/tracing": "^7.120.4",
        "@sentry/vue": "^10.21.0",
        "@vitejs/plugin-vue": "^4.6.0",
        "@vueuse/core": "^13.9.0",
        "axios": "^1.12.2",
        "pinia": "^3.0.3",
        "vue": "^3.5.22",
        "vue-i18n": "^11.1.12",
        "vue-router": "^4.6.3",
        "workbox-webpack-plugin": "^7.3.0"
    }
}
